# Configuración de Base de Datos
# Copia este archivo a .env y reemplaza con tus valores reales.
# NO subas tu contraseña real a Git.

# Ejemplo para Supabase:
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@[TU_HOST]:5432/postgres"

# Ejemplo para local (SQLite):
# DATABASE_URL="sqlite:///./app.db"
