# ============================================
# BACKEND - VARIABLES DE ENTORNO
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y nómbralo ".env"
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA hagas commit de .env (ya está en .gitignore)
# 4. Mantén .env.example en git como referencia
#
# ============================================

# --- DATABASE ---
# Para desarrollo local con SQLite:
DATABASE_URL=sqlite:///./app.db

# Para producción con Supabase PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# --- SUPABASE (Autenticación y Base de datos) ---
# Obtén estas credenciales de https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here
