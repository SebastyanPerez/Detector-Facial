# ============================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y nómbralo ".env.local"
# 2. Reemplaza los valores [YOUR_*] con tus credenciales reales
# 3. NUNCA hagas commit de .env.local (ya está en .gitignore)
# 4. Mantén .env.example en git como referencia
#
# ============================================

# --- API DEL BACKEND ---
VITE_API_URL=http://localhost:8000/api/v1/face

# --- SUPABASE (Autenticación) ---
VITE_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
VITE_SUPABASE_KEY=[YOUR_SUPABASE_ANON_KEY]

# --- CONFIGURACIÓN DE APLICACIÓN ---
VITE_APP_NAME=MediScan
VITE_APP_VERSION=1.0.0

# --- DEBUG (Solo en desarrollo) ---
VITE_DEBUG=false
